<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Learning Resources - MentorLink</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Lora:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/premium-ui.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Lora', serif;
            background: linear-gradient(135deg, #F3F4F6 0%, #E5E7EB 100%);
            color: #1E3A8A;
            line-height: 1.6;
        }

        nav {
            background: linear-gradient(135deg, #1E3A8A 0%, #1F4ED8 100%);
            padding: 1rem 2rem;
            box-shadow: 0 4px 15px rgba(25, 25, 112, 0.3);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 800;
            color: white;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;
        }

        .nav-links a:hover {
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
        }

        .nav-buttons {
            display: flex;
            gap: 1rem;
        }

        .nav-user {
            color: white;
            font-weight: 700;
            font-family: 'Lora', serif;
            letter-spacing: 0.5px;
        }

        .nav-logout {
            margin-left: 0.8rem;
            padding: 0.45rem 0.9rem;
            border: 2px solid white;
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.2);
            color: white;
            cursor: pointer;
            font-weight: 600;
        }

        .nav-logout:hover {
            background: white;
            color: #1E3A8A;
        }

        .btn-nav {
            padding: 0.6rem 1.2rem;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            text-decoration: none;
        }

        .btn-login {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            border: 2px solid white;
        }

        .btn-login:hover {
            background: white;
            color: #1E3A8A;
        }

        .btn-signup {
            background: white;
            color: #1E3A8A;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 3rem 2rem;
        }

        h1 {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: 2rem;
            background: linear-gradient(135deg, #1E3A8A 0%, #1F4ED8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 2px;
        }

        .filter-section {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .filter-btn {
            padding: 0.6rem 1.2rem;
            border: 2px solid #1E3A8A;
            background: white;
            color: #1E3A8A;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 600;
            transition: 0.3s;
        }

        .filter-btn:hover,
        .filter-btn.active {
            background: #1E3A8A;
            color: white;
        }

        .resources-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .resource-card {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(25, 25, 112, 0.1);
            transition: 0.3s;
            border-top: 4px solid #1E3A8A;
        }

        .resource-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 8px 25px rgba(25, 25, 112, 0.2);
        }

        .resource-badge {
            background: linear-gradient(135deg, #1E3A8A 0%, #1F4ED8 100%);
            color: white;
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .resource-content {
            padding: 1.5rem;
        }

        .resource-content h3 {
            color: #1E3A8A;
            margin-bottom: 0.5rem;
            font-size: 1.4rem;
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 1px;
        }

        .resource-content p {
            color: #1E3A8A;
            margin-bottom: 1rem;
            font-size: 0.95rem;
        }

        .resource-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            font-size: 0.9rem;
            color: #1E3A8A;
        }

        .resource-btn {
            background: linear-gradient(135deg, #1E3A8A 0%, #1F4ED8 100%);
            color: white;
            border: none;
            padding: 0.7rem 1.5rem;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: 0.3s;
        }

        .resource-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(25, 25, 112, 0.3);
        }

        .categories {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
            margin-top: 3rem;
        }

        .category-card {
            background: white;
            padding: 1.5rem;
            border-radius: 8px;
            text-align: center;
            border: 2px solid #F3F4F6;
            transition: 0.3s;
        }

        .category-card:hover {
            border-color: #1E3A8A;
            background: #f5fbff;
        }

        .category-icon {
            font-size: 2.5rem;
            color: #1E3A8A;
            margin-bottom: 0.5rem;
        }

        .category-card h3 {
            color: #1E3A8A;
            margin-bottom: 0.5rem;
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 1px;
        }

        .category-card p {
            color: #1E3A8A;
            font-size: 0.9rem;
        }

        footer {
            background: linear-gradient(135deg, #1F4ED8 0%, #1E40AF 100%);
            color: white;
            padding: 2rem;
            text-align: center;
            margin-top: 3rem;
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 1.8rem;
            }

            .resources-grid {
                grid-template-columns: 1fr;
            }

            .filter-section {
                justify-content: flex-start;
                overflow-x: auto;
            }
        }
    </style>
</head>
<body class="premium-ui">
    <!-- Navigation -->
    <nav>
        <div class="nav-container">
            <div class="logo">
                <i class="fas fa-link"></i> MentorLink
            </div>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/mentors">Mentors</a></li>
                <li><a href="/resources">Resources</a></li>
            </ul>
            <div class="nav-buttons" id="navButtons">
                <a href="/signup" class="btn-nav btn-login">Login</a>
                <a href="/signup" class="btn-nav btn-signup">Sign Up</a>
            </div>
            <div class="nav-user" id="navUser"></div>
            <button class="nav-logout" id="navLogout" style="display:none;" type="button">Logout</button>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container">
        <h1>Learning Resources</h1>

        <div style="background: white; padding: 1.5rem; border-radius: 10px; margin-bottom: 2rem; text-align: center;">
            <p style="color: #1E3A8A; font-size: 1.1rem;">
                Explore our curated collection of learning materials, tutorials, and guides to enhance your mentorship experience.
            </p>
        </div>

        <!-- Resource Categories -->
        <h2 style="text-align: center; font-size: 2rem; color: #1E3A8A; margin-bottom: 2rem; font-family: 'Bebas Neue', sans-serif; letter-spacing: 1px;">
            <i class="fas fa-folder-open"></i> Resource Categories
        </h2>

        <div class="categories">
            <div class="category-card">
                <div class="category-icon">
                    <i class="fas fa-code"></i>
                </div>
                <h3>Programming</h3>
                <p>Learn coding fundamentals, web development, and software engineering practices</p>
            </div>

            <div class="category-card">
                <div class="category-icon">
                    <i class="fas fa-briefcase"></i>
                </div>
                <h3>Career Development</h3>
                <p>Resume building, interview preparation, and professional growth strategies</p>
            </div>

            <div class="category-card">
                <div class="category-icon">
                    <i class="fas fa-chart-bar"></i>
                </div>
                <h3>Data Science</h3>
                <p>Machine learning, data analysis, and statistical modeling techniques</p>
            </div>

            <div class="category-card">
                <div class="category-icon">
                    <i class="fas fa-paint-brush"></i>
                </div>
                <h3>Design</h3>
                <p>UI/UX design principles, web design, and creative problem-solving</p>
            </div>

            <div class="category-card">
                <div class="category-icon">
                    <i class="fas fa-mobile-alt"></i>
                </div>
                <h3>Mobile Development</h3>
                <p>iOS, Android, and cross-platform mobile app development</p>
            </div>

            <div class="category-card">
                <div class="category-icon">
                    <i class="fas fa-cogs"></i>
                </div>
                <h3>DevOps</h3>
                <p>Cloud deployment, CI/CD pipelines, and infrastructure management</p>
            </div>
        </div>

        <!-- Featured Resources -->
        <h2 style="text-align: center; font-size: 2rem; color: #1E3A8A; margin-bottom: 2rem; margin-top: 3rem; font-family: 'Bebas Neue', sans-serif; letter-spacing: 1px;">
            <i class="fas fa-star"></i> Featured Resources
        </h2>

        <div class="resources-grid">
            <div class="resource-card">
                <div class="resource-badge">
                    <i class="fas fa-video"></i> Tutorial
                </div>
                <div class="resource-content">
                    <h3>Node.js & Express.js Fundamentals</h3>
                    <p>Complete guide to building backend applications with Node.js and Express.js</p>
                    <div class="resource-meta">
                        <span><i class="fas fa-clock"></i> 4 hours</span>
                        <span><i class="fas fa-star"></i> 4.9/5</span>
                    </div>
                    <a href="https://nodejs.org/en/learn/getting-started/introduction-to-nodejs" target="_blank" rel="noopener noreferrer" class="resource-btn">
                        <i class="fas fa-play-circle"></i> Watch Tutorial
                    </a>
                </div>
            </div>

            <div class="resource-card">
                <div class="resource-badge">
                    <i class="fas fa-book"></i> Guide
                </div>
                <div class="resource-content">
                    <h3>Web Development Best Practices</h3>
                    <p>Essential practices for writing scalable, maintainable web applications</p>
                    <div class="resource-meta">
                        <span><i class="fas fa-file-alt"></i> 15 pages</span>
                        <span><i class="fas fa-star"></i> 4.8/5</span>
                    </div>
                    <a href="https://developer.mozilla.org/en-US/docs/Learn" target="_blank" rel="noopener noreferrer" class="resource-btn">
                        <i class="fas fa-download"></i> Download PDF
                    </a>
                </div>
            </div>

            <div class="resource-card">
                <div class="resource-badge">
                    <i class="fas fa-code"></i> Code Examples
                </div>
                <div class="resource-content">
                    <h3>MongoDB Database Patterns</h3>
                    <p>Practical MongoDB patterns and best practices for data modeling</p>
                    <div class="resource-meta">
                        <span><i class="fas fa-github"></i> GitHub Repo</span>
                        <span><i class="fas fa-star"></i> 4.7/5</span>
                    </div>
                    <a href="https://www.mongodb.com/docs/manual/data-modeling/" target="_blank" rel="noopener noreferrer" class="resource-btn">
                        <i class="fas fa-link"></i> View Code
                    </a>
                </div>
            </div>

            <div class="resource-card">
                <div class="resource-badge">
                    <i class="fas fa-graduation-cap"></i> Course
                </div>
                <div class="resource-content">
                    <h3>Full Stack Development Masterclass</h3>
                    <p>End-to-end full-stack development with modern technologies</p>
                    <div class="resource-meta">
                        <span><i class="fas fa-clock"></i> 40 hours</span>
                        <span><i class="fas fa-star"></i> 4.9/5</span>
                    </div>
                    <a href="https://fullstackopen.com/en/" target="_blank" rel="noopener noreferrer" class="resource-btn">
                        <i class="fas fa-arrow-right"></i> Explore Course
                    </a>
                </div>
            </div>

            <div class="resource-card">
                <div class="resource-badge">
                    <i class="fas fa-tools"></i> Tools
                </div>
                <div class="resource-content">
                    <h3>Essential Developer Tools</h3>
                    <p>Curated list of tools and resources for web developers</p>
                    <div class="resource-meta">
                        <span><i class="fas fa-list"></i> 50+ Tools</span>
                        <span><i class="fas fa-star"></i> 4.8/5</span>
                    </div>
                    <a href="https://roadmap.sh" target="_blank" rel="noopener noreferrer" class="resource-btn">
                        <i class="fas fa-external-link-alt"></i> Explore Tools
                    </a>
                </div>
            </div>

            <div class="resource-card">
                <div class="resource-badge">
                    <i class="fas fa-comment"></i> Interview
                </div>
                <div class="resource-content">
                    <h3>Technical Interview Preparation</h3>
                    <p>Master coding interviews with common problem patterns and solutions</p>
                    <div class="resource-meta">
                        <span><i class="fas fa-question-circle"></i> 100+ Problems</span>
                        <span><i class="fas fa-star"></i> 4.9/5</span>
                    </div>
                    <a href="https://neetcode.io/practice" target="_blank" rel="noopener noreferrer" class="resource-btn">
                        <i class="fas fa-play-circle"></i> Start Prep
                    </a>
                </div>
            </div>
        </div>

        <!-- Call to Action -->
        <div style="background: linear-gradient(135deg, #1E3A8A 0%, #1F4ED8 100%); color: white; padding: 2rem; border-radius: 10px; text-align: center; margin-top: 3rem;">
            <h2 style="margin-bottom: 1rem;">More Resources Coming Soon</h2>
            <p style="margin-bottom: 1rem;">We're constantly adding new resources. Get connected with a mentor for personalized guidance!</p>
            <a href="/mentors" style="background: white; color: #1E3A8A; padding: 0.8rem 1.5rem; border-radius: 5px; text-decoration: none; font-weight: 600; display: inline-block;">
                <i class="fas fa-users"></i> Find a Mentor
            </a>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <strong>&copy; 2026 MentorLink</strong> - Learning Resources & Mentorship Hub
    </footer>
</body>
<script>
    // Normalize navbar auth state across tabs/pages.
    (function () {
        try {
            const token = localStorage.getItem('token') || sessionStorage.getItem('token');
            const userJson = localStorage.getItem('user') || sessionStorage.getItem('user');
            let user = null;
            try { user = userJson ? JSON.parse(userJson) : null; } catch (_) { user = null; }

            const navButtons = document.getElementById('navButtons');
            const navUser = document.getElementById('navUser');
            const navLogout = document.getElementById('navLogout');

            if (!token) {
                if (navButtons) navButtons.style.display = 'flex';
                if (navUser) navUser.textContent = '';
                if (navLogout) navLogout.style.display = 'none';
                return;
            }

            if (!localStorage.getItem('token')) localStorage.setItem('token', token);
            if (!sessionStorage.getItem('token')) sessionStorage.setItem('token', token);
            if (userJson && !localStorage.getItem('user')) localStorage.setItem('user', userJson);
            if (userJson && !sessionStorage.getItem('user')) sessionStorage.setItem('user', userJson);

            if (navButtons) navButtons.style.display = 'none';
            if (navUser) navUser.textContent = user && user.name ? user.name : 'My Account';
            if (navLogout) {
                navLogout.style.display = 'inline-block';
                navLogout.onclick = function () {
                    localStorage.removeItem('token');
                    localStorage.removeItem('user');
                    sessionStorage.removeItem('token');
                    sessionStorage.removeItem('user');
                    window.location.replace('/signup');
                };
            }
        } catch (e) {
            // Keep auth state intact if UI rendering fails.
        }
    })();
</script>
<script src="/js/auth-nav.js"></script>
</html>




